# Google OAuth client credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# X OAuth 2.0 confidential client credentials
X_CLIENT_ID=
X_CLIENT_SECRET=

# Apple Services ID and generated client-secret JWT
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Needed to keep OAuth session cookies secure on an HTTPS deployment
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-value
